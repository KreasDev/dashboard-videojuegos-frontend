# Copia este archivo como .env y ajusta los valores.
# Las variables VITE_* son visibles en el navegador: NO pongas contraseñas ni secretos.

# URL base del API LDAP que devuelve el JWT al iniciar sesión.
VITE_LDAP_API_URL=http://localhost:8000

# URL base del backend de videojuegos (GET/POST protegidos con Bearer Token).
VITE_BACKEND_API_URL=http://localhost:3000
